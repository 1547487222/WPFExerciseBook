<UserControl x:Class="LaboratoryManagementSystem.Views.ProductionLineEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="1000"
             Background="#1E1E1E">
    
    <UserControl.Resources>
        <SolidColorBrush x:Key="BackgroundBrush" Color="#1E1E1E"/>
        <SolidColorBrush x:Key="PanelBrush" Color="#252526"/>
        <SolidColorBrush x:Key="ForegroundBrush" Color="#CCCCCC"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#007ACC"/>
        <SolidColorBrush x:Key="BorderBrush" Color="#3E3E42"/>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="{StaticResource PanelBrush}" 
                Padding="20,15" BorderThickness="0,0,0,1" 
                BorderBrush="{StaticResource BorderBrush}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Production Line Editor (产线工艺流程)" 
                               FontSize="20" FontWeight="Bold" 
                               Foreground="{StaticResource ForegroundBrush}"/>
                    <TextBlock Text="Compose production workflow from platform tasks, transfers, and modules" 
                               FontSize="12" Foreground="#999999" Margin="0,5,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="💾 Save" Margin="5,0" Padding="15,8" 
                            Background="{StaticResource AccentBrush}" 
                            Foreground="White" BorderThickness="0"/>
                    <Button Content="✓ Validate" Margin="5,0" Padding="15,8" 
                            Background="#2D7D2D" 
                            Foreground="White" BorderThickness="0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Content -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Toolbox -->
            <Border Grid.Column="0" Background="{StaticResource PanelBrush}" 
                    BorderThickness="0,0,1,0" BorderBrush="{StaticResource BorderBrush}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="15">
                        <!-- Platform Tasks Section -->
                        <Expander Header="PLATFORM TASKS (平台任务)" 
                                  IsExpanded="True"
                                  Foreground="#999999" FontSize="12" FontWeight="Bold">
                            <StackPanel Margin="0,10,0,0">
                                <Border Background="#2A2D2E" Padding="10" Margin="0,5" 
                                        BorderThickness="1" BorderBrush="{StaticResource BorderBrush}">
                                    <StackPanel>
                                        <TextBlock Text="⚙️ Quality Check Task" 
                                                   Foreground="{StaticResource ForegroundBrush}" 
                                                   FontWeight="SemiBold"/>
                                        <TextBlock Text="Perform quality inspection" 
                                                   FontSize="10" Foreground="#999999" Margin="0,3,0,0"/>
                                    </StackPanel>
                                </Border>

                                <Border Background="#2A2D2E" Padding="10" Margin="0,5" 
                                        BorderThickness="1" BorderBrush="{StaticResource BorderBrush}">
                                    <StackPanel>
                                        <TextBlock Text="⚙️ Assembly Task" 
                                                   Foreground="{StaticResource ForegroundBrush}" 
                                                   FontWeight="SemiBold"/>
                                        <TextBlock Text="Assemble components" 
                                                   FontSize="10" Foreground="#999999" Margin="0,3,0,0"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Expander>

                        <!-- Transfer Operations Section -->
                        <Expander Header="TRANSFER OPERATIONS (中转)" 
                                  IsExpanded="True" Margin="0,15,0,0"
                                  Foreground="#999999" FontSize="12" FontWeight="Bold">
                            <StackPanel Margin="0,10,0,0">
                                <Border Background="#2A2D2E" Padding="10" Margin="0,5" 
                                        BorderThickness="1" BorderBrush="{StaticResource BorderBrush}">
                                    <StackPanel>
                                        <TextBlock Text="↔️ Transfer Station A" 
                                                   Foreground="{StaticResource ForegroundBrush}" 
                                                   FontWeight="SemiBold"/>
                                        <TextBlock Text="Main transfer point" 
                                                   FontSize="10" Foreground="#999999" Margin="0,3,0,0"/>
                                    </StackPanel>
                                </Border>

                                <Border Background="#2A2D2E" Padding="10" Margin="0,5" 
                                        BorderThickness="1" BorderBrush="{StaticResource BorderBrush}">
                                    <StackPanel>
                                        <TextBlock Text="↔️ Transfer Station B" 
                                                   Foreground="{StaticResource ForegroundBrush}" 
                                                   FontWeight="SemiBold"/>
                                        <TextBlock Text="Secondary transfer point" 
                                                   FontSize="10" Foreground="#999999" Margin="0,3,0,0"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Expander>

                        <!-- Modules Section -->
                        <Expander Header="MODULES (模块)" 
                                  IsExpanded="True" Margin="0,15,0,0"
                                  Foreground="#999999" FontSize="12" FontWeight="Bold">
                            <StackPanel Margin="0,10,0,0">
                                <Border Background="#2A2D2E" Padding="10" Margin="0,5" 
                                        BorderThickness="1" BorderBrush="{StaticResource BorderBrush}">
                                    <StackPanel>
                                        <TextBlock Text="🏢 Warehouse" 
                                                   Foreground="{StaticResource ForegroundBrush}" 
                                                   FontWeight="SemiBold"/>
                                        <TextBlock Text="Storage facility" 
                                                   FontSize="10" Foreground="#999999" Margin="0,3,0,0"/>
                                    </StackPanel>
                                </Border>

                                <Border Background="#2A2D2E" Padding="10" Margin="0,5" 
                                        BorderThickness="1" BorderBrush="{StaticResource BorderBrush}">
                                    <StackPanel>
                                        <TextBlock Text="🤖 Robot Arm" 
                                                   Foreground="{StaticResource ForegroundBrush}" 
                                                   FontWeight="SemiBold"/>
                                        <TextBlock Text="Manipulation device" 
                                                   FontSize="10" Foreground="#999999" Margin="0,3,0,0"/>
                                    </StackPanel>
                                </Border>

                                <Border Background="#2A2D2E" Padding="10" Margin="0,5" 
                                        BorderThickness="1" BorderBrush="{StaticResource BorderBrush}">
                                    <StackPanel>
                                        <TextBlock Text="🚗 AGV" 
                                                   Foreground="{StaticResource ForegroundBrush}" 
                                                   FontWeight="SemiBold"/>
                                        <TextBlock Text="Automated transport" 
                                                   FontSize="10" Foreground="#999999" Margin="0,3,0,0"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Expander>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- Workflow Canvas -->
            <Border Grid.Column="1" Background="{StaticResource BackgroundBrush}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Production Line Info -->
                    <Border Grid.Row="0" Background="{StaticResource PanelBrush}" 
                            Padding="15,10" Margin="15,15,15,0" 
                            BorderThickness="1" BorderBrush="{StaticResource BorderBrush}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Production Line:" 
                                       Foreground="#999999" VerticalAlignment="Center" 
                                       Margin="0,0,10,5"/>
                            <TextBox Grid.Row="0" Grid.Column="1" Text="New Production Line" 
                                     Background="#2A2D2E" Foreground="{StaticResource ForegroundBrush}" 
                                     BorderBrush="{StaticResource BorderBrush}" Padding="8,5" Margin="0,0,0,5"/>
                            
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Process Name:" 
                                       Foreground="#999999" VerticalAlignment="Center" 
                                       Margin="0,0,10,0"/>
                            <TextBox Grid.Row="1" Grid.Column="1" Text="Process 1" 
                                     Background="#2A2D2E" Foreground="{StaticResource ForegroundBrush}" 
                                     BorderBrush="{StaticResource BorderBrush}" Padding="8,5"/>
                        </Grid>
                    </Border>

                    <!-- Process Flow Diagram Area -->
                    <Border Grid.Row="1" Margin="15" 
                            Background="#252526" 
                            BorderThickness="2" 
                            BorderBrush="{StaticResource BorderBrush}"
                            AllowDrop="True">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                            <StackPanel Margin="20">
                                <TextBlock Text="Drag and drop items to compose production workflow" 
                                           FontSize="14" Foreground="#666666" 
                                           HorizontalAlignment="Center" Margin="0,30,0,20"/>
                                
                                <TextBlock Text="Workflow can include:" 
                                           FontSize="12" Foreground="#666666" 
                                           HorizontalAlignment="Center"/>
                                <TextBlock Text="• Platform Tasks (平台任务)" 
                                           FontSize="12" Foreground="#666666" 
                                           HorizontalAlignment="Center" Margin="0,5,0,0"/>
                                <TextBlock Text="• Transfer Operations (中转)" 
                                           FontSize="12" Foreground="#666666" 
                                           HorizontalAlignment="Center" Margin="0,5,0,0"/>
                                <TextBlock Text="• Module Actions (模块动作)" 
                                           FontSize="12" Foreground="#666666" 
                                           HorizontalAlignment="Center" Margin="0,5,0,0"/>

                                <!-- Example workflow step (would be dynamically generated) -->
                                <StackPanel Margin="0,40,0,0" Visibility="Collapsed">
                                    <Border Background="#2A2D2E" Padding="15" Margin="0,10" 
                                            BorderThickness="2" BorderBrush="#4EC9B0">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            
                                            <Border Grid.Column="0" Background="{StaticResource AccentBrush}" 
                                                    Width="40" Height="40" CornerRadius="20" 
                                                    Margin="0,0,15,0">
                                                <TextBlock Text="1" 
                                                           FontSize="20" FontWeight="Bold" 
                                                           Foreground="White" 
                                                           HorizontalAlignment="Center" 
                                                           VerticalAlignment="Center"/>
                                            </Border>
                                            
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="Platform Task: Quality Check" 
                                                           FontSize="14" FontWeight="SemiBold" 
                                                           Foreground="{StaticResource ForegroundBrush}"/>
                                                <TextBlock Text="Type: Platform Task (平台任务)" 
                                                           FontSize="11" Foreground="#4EC9B0" Margin="0,3,0,0"/>
                                                <TextBlock Text="Perform quality inspection on components" 
                                                           FontSize="11" Foreground="#999999" Margin="0,3,0,0"/>
                                            </StackPanel>
                                            
                                            <StackPanel Grid.Column="2" Orientation="Horizontal">
                                                <Button Content="⚙️" 
                                                        Background="Transparent" Foreground="{StaticResource AccentBrush}" 
                                                        BorderThickness="0" Padding="8" 
                                                        ToolTip="Configure step"/>
                                                <Button Content="🗑️" 
                                                        Background="Transparent" Foreground="#D16969" 
                                                        BorderThickness="0" Padding="8" 
                                                        ToolTip="Remove step"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <!-- Arrow connector -->
                                    <TextBlock Text="⬇️" FontSize="24" 
                                               HorizontalAlignment="Center" 
                                               Foreground="#666666" Margin="0,5"/>

                                    <Border Background="#2A2D2E" Padding="15" Margin="0,10" 
                                            BorderThickness="2" BorderBrush="#CE9178">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            
                                            <Border Grid.Column="0" Background="#CE9178" 
                                                    Width="40" Height="40" CornerRadius="20" 
                                                    Margin="0,0,15,0">
                                                <TextBlock Text="2" 
                                                           FontSize="20" FontWeight="Bold" 
                                                           Foreground="White" 
                                                           HorizontalAlignment="Center" 
                                                           VerticalAlignment="Center"/>
                                            </Border>
                                            
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="Transfer: Station A" 
                                                           FontSize="14" FontWeight="SemiBold" 
                                                           Foreground="{StaticResource ForegroundBrush}"/>
                                                <TextBlock Text="Type: Transfer (中转)" 
                                                           FontSize="11" Foreground="#CE9178" Margin="0,3,0,0"/>
                                                <TextBlock Text="Move materials to transfer station" 
                                                           FontSize="11" Foreground="#999999" Margin="0,3,0,0"/>
                                            </StackPanel>
                                            
                                            <StackPanel Grid.Column="2" Orientation="Horizontal">
                                                <Button Content="⚙️" 
                                                        Background="Transparent" Foreground="{StaticResource AccentBrush}" 
                                                        BorderThickness="0" Padding="8" 
                                                        ToolTip="Configure step"/>
                                                <Button Content="🗑️" 
                                                        Background="Transparent" Foreground="#D16969" 
                                                        BorderThickness="0" Padding="8" 
                                                        ToolTip="Remove step"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>

                    <!-- Actions -->
                    <Border Grid.Row="2" Background="{StaticResource PanelBrush}" 
                            Padding="15,10" Margin="15,0,15,15" 
                            BorderThickness="1" BorderBrush="{StaticResource BorderBrush}">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="+ Add Process" Margin="5,0" Padding="15,8" 
                                    Background="#2A2D2E" 
                                    Foreground="{StaticResource ForegroundBrush}" 
                                    BorderThickness="1" BorderBrush="{StaticResource BorderBrush}"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
