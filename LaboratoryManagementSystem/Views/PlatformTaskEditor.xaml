<UserControl x:Class="LaboratoryManagementSystem.Views.PlatformTaskEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="800"
             Background="#1E1E1E">
    
    <UserControl.Resources>
        <SolidColorBrush x:Key="BackgroundBrush" Color="#1E1E1E"/>
        <SolidColorBrush x:Key="PanelBrush" Color="#252526"/>
        <SolidColorBrush x:Key="ForegroundBrush" Color="#CCCCCC"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#007ACC"/>
        <SolidColorBrush x:Key="BorderBrush" Color="#3E3E42"/>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="{StaticResource PanelBrush}" 
                Padding="20,15" BorderThickness="0,0,0,1" 
                BorderBrush="{StaticResource BorderBrush}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Platform Task Editor" 
                               FontSize="20" FontWeight="Bold" 
                               Foreground="{StaticResource ForegroundBrush}"/>
                    <TextBlock Text="Compose workflow by dragging modules and actions" 
                               FontSize="12" Foreground="#999999" Margin="0,5,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="💾 Save" Margin="5,0" Padding="15,8" 
                            Background="{StaticResource AccentBrush}" 
                            Foreground="White" BorderThickness="0"/>
                    <Button Content="▶️ Execute" Margin="5,0" Padding="15,8" 
                            Background="#2D7D2D" 
                            Foreground="White" BorderThickness="0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Content -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Toolbox -->
            <Border Grid.Column="0" Background="{StaticResource PanelBrush}" 
                    BorderThickness="0,0,1,0" BorderBrush="{StaticResource BorderBrush}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="15">
                        <TextBlock Text="AVAILABLE MODULES" 
                                   FontSize="12" FontWeight="Bold" 
                                   Foreground="#999999" Margin="0,0,0,10"/>
                        
                        <!-- Module items would be data-bound here -->
                        <Border Background="#2A2D2E" Padding="10" Margin="0,5" 
                                BorderThickness="1" BorderBrush="{StaticResource BorderBrush}"
                                AllowDrop="False">
                            <StackPanel>
                                <TextBlock Text="🏢 Warehouse Module" 
                                           Foreground="{StaticResource ForegroundBrush}" 
                                           FontWeight="SemiBold"/>
                                <TextBlock Text="Storage and retrieval operations" 
                                           FontSize="10" Foreground="#999999" Margin="0,3,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Background="#2A2D2E" Padding="10" Margin="0,5" 
                                BorderThickness="1" BorderBrush="{StaticResource BorderBrush}">
                            <StackPanel>
                                <TextBlock Text="🤖 Robot Module" 
                                           Foreground="{StaticResource ForegroundBrush}" 
                                           FontWeight="SemiBold"/>
                                <TextBlock Text="Robotic arm operations" 
                                           FontSize="10" Foreground="#999999" Margin="0,3,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Background="#2A2D2E" Padding="10" Margin="0,5" 
                                BorderThickness="1" BorderBrush="{StaticResource BorderBrush}">
                            <StackPanel>
                                <TextBlock Text="🚗 AGV Module" 
                                           Foreground="{StaticResource ForegroundBrush}" 
                                           FontWeight="SemiBold"/>
                                <TextBlock Text="Automated transport" 
                                           FontSize="10" Foreground="#999999" Margin="0,3,0,0"/>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="TRANSFER OPERATIONS" 
                                   FontSize="12" FontWeight="Bold" 
                                   Foreground="#999999" Margin="0,20,0,10"/>

                        <Border Background="#2A2D2E" Padding="10" Margin="0,5" 
                                BorderThickness="1" BorderBrush="{StaticResource BorderBrush}">
                            <StackPanel>
                                <TextBlock Text="↔️ Transfer Point" 
                                           Foreground="{StaticResource ForegroundBrush}" 
                                           FontWeight="SemiBold"/>
                                <TextBlock Text="Material transfer operation" 
                                           FontSize="10" Foreground="#999999" Margin="0,3,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- Workflow Canvas -->
            <Border Grid.Column="1" Background="{StaticResource BackgroundBrush}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Workflow Info -->
                    <Border Grid.Row="0" Background="{StaticResource PanelBrush}" 
                            Padding="15,10" Margin="15,15,15,0" 
                            BorderThickness="1" BorderBrush="{StaticResource BorderBrush}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            
                            <TextBlock Grid.Column="0" Text="Task Name:" 
                                       Foreground="#999999" VerticalAlignment="Center" 
                                       Margin="0,0,10,0"/>
                            <TextBox Grid.Column="1" Text="New Platform Task" 
                                     Background="#2A2D2E" Foreground="{StaticResource ForegroundBrush}" 
                                     BorderBrush="{StaticResource BorderBrush}" Padding="8,5"/>
                        </Grid>
                    </Border>

                    <!-- Workflow Steps Area -->
                    <Border Grid.Row="1" Margin="15" 
                            Background="#252526" 
                            BorderThickness="2" 
                            BorderBrush="{StaticResource BorderBrush}"
                            AllowDrop="True">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="20">
                                <TextBlock Text="Drop modules here to compose workflow" 
                                           FontSize="14" Foreground="#666666" 
                                           HorizontalAlignment="Center" 
                                           VerticalAlignment="Center" Margin="0,50,0,0"/>
                                
                                <!-- Workflow steps would be added here -->
                                <Border Background="#2A2D2E" Padding="15" Margin="0,20,0,10" 
                                        BorderThickness="1" BorderBrush="{StaticResource AccentBrush}"
                                        Visibility="Collapsed">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        
                                        <TextBlock Grid.Column="0" Text="1" 
                                                   FontSize="20" FontWeight="Bold" 
                                                   Foreground="{StaticResource AccentBrush}" 
                                                   VerticalAlignment="Center" Margin="0,0,15,0"/>
                                        
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="Warehouse: Retrieve Item" 
                                                       FontSize="14" FontWeight="SemiBold" 
                                                       Foreground="{StaticResource ForegroundBrush}"/>
                                            <TextBlock Text="Retrieve item from warehouse storage" 
                                                       FontSize="11" Foreground="#999999" Margin="0,3,0,0"/>
                                        </StackPanel>
                                        
                                        <Button Grid.Column="2" Content="🗑️" 
                                                Background="Transparent" Foreground="#D16969" 
                                                BorderThickness="0" Padding="8" 
                                                ToolTip="Remove step"/>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
