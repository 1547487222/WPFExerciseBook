<Window x:Class="LaboratoryManagementSystem.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:LaboratoryManagementSystem"
        xmlns:vm="clr-namespace:LaboratoryManagementSystem.ViewModels"
        mc:Ignorable="d"
        Title="Laboratory Management System" Height="800" Width="1400"
        Background="#1E1E1E">
    
    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Window.Resources>
        <!-- VS Code-like Color Scheme -->
        <SolidColorBrush x:Key="BackgroundBrush" Color="#1E1E1E"/>
        <SolidColorBrush x:Key="SidebarBrush" Color="#252526"/>
        <SolidColorBrush x:Key="ActivityBarBrush" Color="#333333"/>
        <SolidColorBrush x:Key="ForegroundBrush" Color="#CCCCCC"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#007ACC"/>
        <SolidColorBrush x:Key="HoverBrush" Color="#2A2D2E"/>
        <SolidColorBrush x:Key="SelectedBrush" Color="#37373D"/>
        <SolidColorBrush x:Key="BorderBrush" Color="#3E3E42"/>

        <!-- Menu Item Style -->
        <Style x:Key="MenuItemStyle" TargetType="ListBoxItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource ForegroundBrush}"/>
            <Setter Property="Padding" Value="15,10"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border Background="{TemplateBinding Background}" 
                                Padding="{TemplateBinding Padding}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                BorderBrush="{TemplateBinding BorderBrush}">
                            <ContentPresenter/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource HoverBrush}"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{StaticResource SelectedBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Button Style -->
        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="15,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}"
                                CornerRadius="2">
                            <ContentPresenter HorizontalAlignment="Center" 
                                            VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#005A9E"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#004578"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Menu Bar -->
        <Menu Grid.Row="0" Background="{StaticResource ActivityBarBrush}" 
              Foreground="{StaticResource ForegroundBrush}">
            <MenuItem Header="_File" Foreground="{StaticResource ForegroundBrush}">
                <MenuItem Header="_Save Configuration" 
                          Command="{Binding SaveConfigCommand}"
                          InputGestureText="Ctrl+S"/>
                <MenuItem Header="_Load Configuration" 
                          Command="{Binding LoadConfigCommand}"
                          InputGestureText="Ctrl+O"/>
                <MenuItem Header="_Export Configuration..." 
                          Command="{Binding ExportConfigCommand}"/>
                <Separator/>
                <MenuItem Header="E_xit" Click="Exit_Click"/>
            </MenuItem>
            <MenuItem Header="_Help" Foreground="{StaticResource ForegroundBrush}">
                <MenuItem Header="_User Guide" Click="UserGuide_Click"/>
                <MenuItem Header="_About" Click="About_Click"/>
            </MenuItem>
        </Menu>

    <Grid Grid.Row="1">
        <Grid.ColumnDefinitions>
            <!-- Activity Bar (Icons) -->
            <ColumnDefinition Width="50"/>
            <!-- Sidebar -->
            <ColumnDefinition Width="300"/>
            <!-- Main Content Area -->
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Activity Bar (Left-most vertical bar with icons) -->
        <Border Grid.Column="0" Background="{StaticResource ActivityBarBrush}">
            <StackPanel>
                <Button Content="📁" FontSize="24" Height="50" 
                        Background="Transparent" Foreground="{StaticResource ForegroundBrush}"
                        BorderThickness="0" ToolTip="Projects"
                        Click="ShowProjectsView"/>
                <Button Content="🧩" FontSize="24" Height="50" 
                        Background="Transparent" Foreground="{StaticResource ForegroundBrush}"
                        BorderThickness="0" ToolTip="Modules"
                        Click="ShowModulesView"/>
                <Button Content="📦" FontSize="24" Height="50" 
                        Background="Transparent" Foreground="{StaticResource ForegroundBrush}"
                        BorderThickness="0" ToolTip="Resources"
                        Click="ShowResourcesView"/>
                <Button Content="⚙️" FontSize="24" Height="50" 
                        Background="Transparent" Foreground="{StaticResource ForegroundBrush}"
                        BorderThickness="0" ToolTip="Platform Tasks"
                        Click="ShowPlatformTasksView"/>
                <Button Content="🏭" FontSize="24" Height="50" 
                        Background="Transparent" Foreground="{StaticResource ForegroundBrush}"
                        BorderThickness="0" ToolTip="Production Lines"
                        Click="ShowProductionLinesView"/>
            </StackPanel>
        </Border>

        <!-- Sidebar (Menu Panel) -->
        <Border Grid.Column="1" Background="{StaticResource SidebarBrush}" 
                BorderThickness="0,0,1,0" BorderBrush="{StaticResource BorderBrush}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Sidebar Header -->
                <Border Grid.Row="0" Background="{StaticResource ActivityBarBrush}" 
                        Padding="15,10" BorderThickness="0,0,0,1" 
                        BorderBrush="{StaticResource BorderBrush}">
                    <TextBlock x:Name="SidebarTitle" Text="LABORATORY" 
                               Foreground="{StaticResource ForegroundBrush}"
                               FontSize="14" FontWeight="Bold"/>
                </Border>

                <!-- Sidebar Content -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="SidebarContent" Margin="0,10">
                        <!-- Content will be dynamically loaded based on selected view -->
                    </StackPanel>
                </ScrollViewer>

                <!-- Sidebar Actions -->
                <Border Grid.Row="2" Background="{StaticResource ActivityBarBrush}" 
                        Padding="10" BorderThickness="0,1,0,0" 
                        BorderBrush="{StaticResource BorderBrush}">
                    <Button x:Name="SidebarActionButton" Content="+ Add New" 
                            Style="{StaticResource ActionButtonStyle}"
                            HorizontalAlignment="Stretch"/>
                </Border>
            </Grid>
        </Border>

        <!-- Main Content Area -->
        <Border Grid.Column="2" Background="{StaticResource BackgroundBrush}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Title Bar -->
                <Border Grid.Row="0" Background="{StaticResource ActivityBarBrush}" 
                        Padding="20,10" BorderThickness="0,0,0,1" 
                        BorderBrush="{StaticResource BorderBrush}">
                    <TextBlock x:Name="ContentTitle" Text="Welcome to Laboratory Management System" 
                               Foreground="{StaticResource ForegroundBrush}"
                               FontSize="16" FontWeight="SemiBold"/>
                </Border>

                <!-- Main Content -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <Grid x:Name="MainContent" Margin="20">
                        <!-- Welcome Screen -->
                        <StackPanel x:Name="WelcomePanel" VerticalAlignment="Center" 
                                    HorizontalAlignment="Center">
                            <TextBlock Text="🔬 Laboratory Management System" 
                                       FontSize="32" FontWeight="Bold" 
                                       Foreground="{StaticResource AccentBrush}"
                                       HorizontalAlignment="Center" Margin="0,0,0,20"/>
                            <TextBlock Text="Select an option from the left sidebar to get started" 
                                       FontSize="16" Foreground="{StaticResource ForegroundBrush}"
                                       HorizontalAlignment="Center"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" 
                                        Margin="0,30,0,0">
                                <Button Content="Create Project" 
                                        Style="{StaticResource ActionButtonStyle}" 
                                        Margin="5" Padding="20,10"
                                        Command="{Binding AddProjectCommand}"/>
                                <Button Content="Add Module" 
                                        Style="{StaticResource ActionButtonStyle}" 
                                        Margin="5" Padding="20,10"
                                        Command="{Binding AddModuleCommand}"/>
                                <Button Content="Add Resource" 
                                        Style="{StaticResource ActionButtonStyle}" 
                                        Margin="5" Padding="20,10"
                                        Command="{Binding AddResourceCommand}"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- Dynamic Content Panels (Hidden by default) -->
                        <Grid x:Name="ProjectsPanel" Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="Laboratory Projects" 
                                       FontSize="24" FontWeight="Bold" 
                                       Foreground="{StaticResource ForegroundBrush}" Margin="0,0,0,20"/>
                            <ListBox Grid.Row="1" ItemsSource="{Binding LaboratoryConfig.Projects}"
                                     Background="Transparent" BorderThickness="0"
                                     Foreground="{StaticResource ForegroundBrush}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{StaticResource SidebarBrush}" 
                                                Padding="15" Margin="0,5" CornerRadius="4"
                                                BorderThickness="1" BorderBrush="{StaticResource BorderBrush}">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Name}" FontSize="16" 
                                                           FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}"/>
                                                <TextBlock Text="{Binding Description}" FontSize="12" 
                                                           Foreground="{StaticResource ForegroundBrush}" Margin="0,5,0,0"/>
                                                <TextBlock FontSize="11" Foreground="#999999" Margin="0,5,0,0">
                                                    <Run Text="Status: "/>
                                                    <Run Text="{Binding Status}"/>
                                                    <Run Text=" | Created: "/>
                                                    <Run Text="{Binding CreatedDate, StringFormat=yyyy-MM-dd}"/>
                                                </TextBlock>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>

                        <Grid x:Name="ModulesPanel" Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="Available Modules" 
                                       FontSize="24" FontWeight="Bold" 
                                       Foreground="{StaticResource ForegroundBrush}" Margin="0,0,0,20"/>
                            <ListBox Grid.Row="1" ItemsSource="{Binding LaboratoryConfig.Modules}"
                                     Background="Transparent" BorderThickness="0"
                                     Foreground="{StaticResource ForegroundBrush}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{StaticResource SidebarBrush}" 
                                                Padding="15" Margin="0,5" CornerRadius="4"
                                                BorderThickness="1" BorderBrush="{StaticResource BorderBrush}">
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Name}" FontSize="16" 
                                                               FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}"/>
                                                    <Border Background="#2D7D2D" CornerRadius="3" 
                                                            Padding="5,2" Margin="10,0,0,0">
                                                        <TextBlock Text="{Binding Type}" FontSize="10" 
                                                                   Foreground="White"/>
                                                    </Border>
                                                </StackPanel>
                                                <TextBlock Text="{Binding Description}" FontSize="12" 
                                                           Foreground="{StaticResource ForegroundBrush}" Margin="0,5,0,0"/>
                                                <TextBlock Text="{Binding Version, StringFormat='Version: {0}'}" 
                                                           FontSize="11" Foreground="#999999" Margin="0,5,0,0"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>

                        <Grid x:Name="ResourcesPanel" Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="Laboratory Resources" 
                                       FontSize="24" FontWeight="Bold" 
                                       Foreground="{StaticResource ForegroundBrush}" Margin="0,0,0,20"/>
                            <ListBox Grid.Row="1" ItemsSource="{Binding LaboratoryConfig.Resources}"
                                     Background="Transparent" BorderThickness="0"
                                     Foreground="{StaticResource ForegroundBrush}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{StaticResource SidebarBrush}" 
                                                Padding="15" Margin="0,5" CornerRadius="4"
                                                BorderThickness="1" BorderBrush="{StaticResource BorderBrush}">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Name}" FontSize="16" 
                                                           FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}"/>
                                                <TextBlock Text="{Binding Description}" FontSize="12" 
                                                           Foreground="{StaticResource ForegroundBrush}" Margin="0,5,0,0"/>
                                                <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                                    <TextBlock Text="Status: " FontSize="11" Foreground="#999999"/>
                                                    <TextBlock Text="{Binding Status}" FontSize="11" Foreground="#4EC9B0"/>
                                                    <TextBlock Text=" | Type: " FontSize="11" Foreground="#999999" Margin="10,0,0,0"/>
                                                    <TextBlock Text="{Binding Type}" FontSize="11" Foreground="#999999"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>

                        <Grid x:Name="PlatformTasksPanel" Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="Platform Tasks" 
                                       FontSize="24" FontWeight="Bold" 
                                       Foreground="{StaticResource ForegroundBrush}" Margin="0,0,0,20"/>
                            <ListBox Grid.Row="1" ItemsSource="{Binding LaboratoryConfig.PlatformTasks}"
                                     Background="Transparent" BorderThickness="0"
                                     Foreground="{StaticResource ForegroundBrush}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{StaticResource SidebarBrush}" 
                                                Padding="15" Margin="0,5" CornerRadius="4"
                                                BorderThickness="1" BorderBrush="{StaticResource BorderBrush}">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Name}" FontSize="16" 
                                                           FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}"/>
                                                <TextBlock Text="{Binding Description}" FontSize="12" 
                                                           Foreground="{StaticResource ForegroundBrush}" Margin="0,5,0,0"/>
                                                <TextBlock FontSize="11" Foreground="#999999" Margin="0,5,0,0">
                                                    <Run Text="Priority: "/>
                                                    <Run Text="{Binding Priority}"/>
                                                    <Run Text=" | Steps: "/>
                                                    <Run Text="{Binding WorkflowSteps.Count}"/>
                                                </TextBlock>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>

                        <Grid x:Name="ProductionLinesPanel" Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="Production Lines (工艺流程)" 
                                       FontSize="24" FontWeight="Bold" 
                                       Foreground="{StaticResource ForegroundBrush}" Margin="0,0,0,20"/>
                            <ListBox Grid.Row="1" ItemsSource="{Binding LaboratoryConfig.ProductionLines}"
                                     Background="Transparent" BorderThickness="0"
                                     Foreground="{StaticResource ForegroundBrush}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{StaticResource SidebarBrush}" 
                                                Padding="15" Margin="0,5" CornerRadius="4"
                                                BorderThickness="1" BorderBrush="{StaticResource BorderBrush}">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Name}" FontSize="16" 
                                                           FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}"/>
                                                <TextBlock Text="{Binding Description}" FontSize="12" 
                                                           Foreground="{StaticResource ForegroundBrush}" Margin="0,5,0,0"/>
                                                <TextBlock Text="{Binding Processes.Count, StringFormat='Processes: {0}'}" 
                                                           FontSize="11" Foreground="#999999" Margin="0,5,0,0"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Grid>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
    </Grid>
</Window>
