<Window
    x:Class="WPF.BehaviorDemo.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:behaviors="clr-namespace:WPF.BehaviorDemo.Behaviours"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:local="clr-namespace:WPF.BehaviorDemo"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="MainWindow"
    Width="800"
    Height="450"
    mc:Ignorable="d">
    <Grid>
        <DockPanel LastChildFill="True">
            <ListBox DockPanel.Dock="Left" ItemsSource="{Binding Shapes}">
                <i:Interaction.Behaviors>
                    <behaviors:DoDropbehavior />
                </i:Interaction.Behaviors>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock FontSize="20" Text="{Binding ShapeName}" />
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <Canvas Background="White">
                <i:Interaction.Behaviors>
                    <behaviors:CanvasDragBehavior />
                </i:Interaction.Behaviors>
            </Canvas>
        </DockPanel>
    </Grid>
</Window>
