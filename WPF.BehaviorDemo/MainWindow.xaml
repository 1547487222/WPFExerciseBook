<Window
    x:Class="WPF.BehaviorDemo.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:behaviors="clr-namespace:WPF.BehaviorDemo.Behaviours"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:local="clr-namespace:WPF.BehaviorDemo"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="MainWindow"
    Width="800"
    Height="450"
    mc:Ignorable="d">
    <Grid>
        <DockPanel LastChildFill="True">
            <ToolBar DockPanel.Dock="Top">
                <Button Click="OpenEdit_Click" Content="打开编辑" />
                <Button Click="CloseEdit_Click" Content="关闭编辑" />
            </ToolBar>
            <ListBox DockPanel.Dock="Left" ItemsSource="{Binding ViewComponents}">
                <i:Interaction.Behaviors>
                    <behaviors:DoDropbehavior />
                </i:Interaction.Behaviors>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock FontSize="20" Text="{Binding}" />
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <Canvas x:Name="ViewComponentCanvas" Background="White">
                <i:Interaction.Behaviors>
                    <behaviors:ViewComponentCanvasDragBehavior>
                        <behaviors:ViewComponentCanvasDragBehavior.MaskContextMenu>
                            <ContextMenu>
                                <MenuItem Click="Delete_Click" Header="删除" />
                                <MenuItem Click="EditOption_Click" Header="修改配置" />
                            </ContextMenu>
                        </behaviors:ViewComponentCanvasDragBehavior.MaskContextMenu>
                    </behaviors:ViewComponentCanvasDragBehavior>
                </i:Interaction.Behaviors>
            </Canvas>
        </DockPanel>
    </Grid>
</Window>
